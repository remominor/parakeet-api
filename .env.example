PARAKEET_API_KEYS=replace-with-a-long-random-secret
PARAKEET_BIND_ADDRESS=0.0.0.0
PARAKEET_PORT=5092
PARAKEET_MODEL_FILE=tdt-0.6b-v2-f16.gguf
# PARAKEET_MODEL_FILE=tdt-0.6b-v2-q8_0.gguf
PARAKEET_MAX_UPLOAD_MB=64
PARAKEET_UPSTREAM_TIMEOUT=300
PARAKEET_LOG_TRANSCRIPTS=false

# WebSocket PCM16 (16 kHz mono) voice-turn endpointing.
PARAKEET_WS_VAD_THRESHOLD=0.5
PARAKEET_WS_MIN_SILENCE_MS=350
PARAKEET_WS_SPEECH_PAD_MS=120
PARAKEET_WS_MAX_UTTERANCE_MS=8000
PARAKEET_WS_MAX_FRAME_BYTES=65536
