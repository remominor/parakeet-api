PARAKEET_API_KEYS=replace-with-a-long-random-secret
PARAKEET_BIND_ADDRESS=0.0.0.0
PARAKEET_PORT=5092
PARAKEET_ASR_MODEL_FILE=parakeet-unified-en-0.6b-Q8_0.gguf
# Rollback (must be the transcribe.cpp-format artifact):
# PARAKEET_ASR_MODEL_FILE=parakeet-tdt-0.6b-v2-Q8_0.gguf
PARAKEET_DIARIZATION_ENABLED=false
PARAKEET_DIARIZATION_MODEL_FILE=diar_streaming_sortformer_4spk-v2.1-Q8_0.gguf
PARAKEET_IDENTITY_ENABLED=false
PARAKEET_CAMPP_MODEL_FILE=3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx
PARAKEET_SPEAKER_STORE=/data/speakers
# Prefer a stable transcribe.cpp device_id (for example 0000:01:00.0).
# cuda:N is accepted as a filtered-CUDA convenience; bare numbers are rejected.
PARAKEET_ASR_DEVICE=
# Empty inherits PARAKEET_ASR_DEVICE.
PARAKEET_DIARIZATION_DEVICE=
PARAKEET_IDENTITY_THRESHOLD=
PARAKEET_IDENTITY_MARGIN=
PARAKEET_IDENTITY_MINIMUM_AUDIO_MS=1500
# HTTP-only persistent Sortformer AOSC/FIFO sessions.  They retain bounded
# model state and semantic slot bindings, never uploaded PCM.
PARAKEET_SPEAKER_SESSION_TTL_SECONDS=3600
PARAKEET_SPEAKER_SESSION_MAX=16
PARAKEET_CAMPP_INTRA_THREADS=0
PARAKEET_CAMPP_INTER_THREADS=1
PARAKEET_CAMPP_CONCURRENCY=1
PARAKEET_MAX_UPLOAD_MB=64
PARAKEET_UPSTREAM_TIMEOUT=300
PARAKEET_LOG_TRANSCRIPTS=false

# WebSocket PCM16 (16 kHz mono) voice-turn endpointing.
PARAKEET_WS_VAD_THRESHOLD=0.5
PARAKEET_WS_MIN_SILENCE_MS=350
PARAKEET_WS_SPEECH_PAD_MS=120
PARAKEET_WS_MAX_UTTERANCE_MS=8000
PARAKEET_WS_MAX_FRAME_BYTES=65536

# Result quality, remote input safety, and optional diagnostics/UI.
PARAKEET_LOW_CONFIDENCE_THRESHOLD=0.70
PARAKEET_SEGMENT_MAX_DURATION_MS=6000
PARAKEET_SEGMENT_MAX_CHARS=100
PARAKEET_SEGMENT_PAUSE_MS=700
PARAKEET_URL_CONNECT_TIMEOUT=5
PARAKEET_URL_TOTAL_TIMEOUT=30
# PARAKEET_URL_ALLOWED_HOSTS=files.home.example,tower.home.example
PARAKEET_URL_ALLOW_PRIVATE=false
PARAKEET_METRICS_ENABLED=false
PARAKEET_WEBUI_ENABLED=false
